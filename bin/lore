#!/usr/bin/env bash
# lore launcher: focus the running instance, or cold-launch one.
#
# A stale socket (left by a crash) HANGS on connect rather than failing
# (okf research) — so probe with --remote-expr under a manual timeout;
# stock macOS has no timeout(1).
set -euo pipefail

# GUI callers (Raycast script commands, Finder) run with a bare PATH that
# lacks homebrew — make neovide/nvim resolve regardless of who launched us.
case ":$PATH:" in
  *:/opt/homebrew/bin:*) ;;
  *) PATH="/opt/homebrew/bin:$PATH" ;;
esac

SOCK=/tmp/lore.sock
EDITOR_BIN="${LORE_EDITOR:-neovide}"

# Self-locate: this file is the source of truth at bin/lore in the checkout
# (dev mode — raw neovide exec) and a copy shipped by build-bundle at
# Lore.app/Contents/Resources/lore (app mode — cold-launch the bundle it
# lives in). Where it wakes up is the mode switch.
SELF_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
BUNDLE="${SELF_DIR%/Contents/Resources}"
case "$BUNDLE" in
  *.app) [ "$BUNDLE" != "$SELF_DIR" ] || BUNDLE="" ;;
  *) BUNDLE="" ;;
esac

probe() {
  [ -S "$SOCK" ] || return 1
  nvim --server "$SOCK" --remote-expr 1 >/dev/null 2>&1 &
  local pid=$!
  for _ in $(seq 20); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid"
      return $?
    fi
    sleep 0.1
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  return 1
}

if probe; then
  if [ $# -gt 0 ]; then
    nvim --server "$SOCK" --remote "$@"
  fi
  # Only neovide knows this command; ignore failure under terminal nvim.
  nvim --server "$SOCK" --remote-send '<Cmd>NeovideFocus<CR>' 2>/dev/null || true
else
  rm -f "$SOCK"
  if [ -n "$BUNDLE" ]; then
    # App mode: launch through LaunchServices; init.lua serverstarts the
    # socket, so wait for it before handing over any file args.
    open -a "$BUNDLE"
    for _ in $(seq 100); do [ -S "$SOCK" ] && break; sleep 0.1; done
    [ -S "$SOCK" ] || { echo "lore didn't start" >&2; exit 1; }
    if [ $# -gt 0 ]; then
      nvim --server "$SOCK" --remote "$@"
    fi
    nvim --server "$SOCK" --remote-send '<Cmd>NeovideFocus<CR>' 2>/dev/null || true
  elif [ "$(basename "$EDITOR_BIN")" = "neovide" ]; then
    exec env NVIM_APPNAME=lore "$EDITOR_BIN" --fork -- --listen "$SOCK" "$@"
  else
    exec env NVIM_APPNAME=lore "$EDITOR_BIN" --listen "$SOCK" "$@"
  fi
fi
